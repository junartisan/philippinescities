[Unit]
Description=Philippines Cities FastAPI service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=philippines
Group=philippines
WorkingDirectory=/var/www/philippines
EnvironmentFile=/etc/philippines/api.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/var/www/philippines/.venv/bin/gunicorn app.main:app --workers 4 --worker-class uvicorn.workers.UvicornWorker --bind 127.0.0.1:8000 --forwarded-allow-ips=127.0.0.1 --access-logfile - --error-logfile - --timeout 120 --graceful-timeout 30
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
